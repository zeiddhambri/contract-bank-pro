# ============================================================================
# Configuration client (Vite) — copier vers `.env` et renseigner.
# `.env` n'est PAS versionné. Ne jamais y mettre de clé `service_role`.
# ============================================================================

# URL du projet Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé publique `anon` — la confidentialité des données repose sur la RLS
# (cf. supabase/migrations/20260915120000-harden-security.sql).
# ⚠️ Cette clé a été exposée dans l'historique Git du projet : à FAIRE TOURNER
#    (Dashboard → API → Rotate anon key) puis à redéployer.
VITE_SUPABASE_ANON_KEY=eyJ...votre_cle_anon

# development | staging | production
VITE_APP_ENV=development

# ============================================================================
# Variables SERVEUR (Edge Functions) — à définir dans
# Dashboard → Edge Functions → Secrets, jamais dans ce fichier côté client.
# ============================================================================
# OPENAI_API_KEY        clé OpenAI (obligatoire pour les 3 functions IA)
# ALLOWED_ORIGINS       origines autorisées pour le CORS, séparées par des virgules
#                       ex. https://jurix.example.com,https://staging.jurix.example.com
# AI_DAILY_LIMIT        nombre maximal d'appels IA par utilisateur et par jour (défaut 50)
# SUPABASE_URL / SUPABASE_ANON_KEY  fournis automatiquement par le runtime Supabase
